# Copy to .env.local, then add your OpenAI API key.
OPENAI_API_KEY=

# All Python services must use the same Temporal connection.
TEMPORAL_CONFIG_FILE=temporal.local.toml
TEMPORAL_PROFILE=default

# Optional: read private PRs, download Actions artifacts/logs, or increase GitHub rate limits.
# If unset, the workspace tries GH_TOKEN, then gh auth token, then anonymous public access.
# GITHUB_TOKEN=
